{
    "name": "churchtools-extension-survey",
    "private": true,
    "version": "0.2.6",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview",
        "deploy": "npm run build && node scripts/package.js",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "check": "npm run typecheck && npm run lint && npm test && vite build",
        "package:verify": "node scripts/package.js --verify-only"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "26.6.5",
        "@types/qrcode": "1.5.6",
        "@vitejs/plugin-vue": "6.0.10",
        "@vue/test-utils": "2.5.1",
        "eslint": "10.12.0",
        "eslint-plugin-vue": "10.11.1",
        "globals": "17.13.0",
        "jsdom": "30.1.2",
        "postcss": "8.5.29",
        "postcss-selector-parser": "7.1.6",
        "prettier": "3.9.10",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.1",
        "vite": "8.3.4",
        "vitest": "5.0.3",
        "vue-tsc": "3.3.13"
    },
    "dependencies": {
        "@churchtools/churchtools-client": "1.7.3",
        "@iconify-json/lucide": "1.2.142",
        "@nuxt/ui": "4.11.3",
        "@tanstack/vue-query": "5.104.1",
        "qrcode": "1.5.4",
        "vue": "3.5.43",
        "vue-router": "5.4.0"
    },
    "engines": {
        "node": "^22.13.0 || ^24.0.0"
    },
    "overrides": {
        "fontless": {
            "esbuild": "0.28.2"
        }
    }
}
